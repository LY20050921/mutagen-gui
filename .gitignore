__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ============================================================
#  打包产物（PyInstaller）
# ============================================================
build/
dist/
*.spec

# ============================================================
#  本项目的运行时数据
#
#  ⚠️ 这些目录里存的是**本机状态**，可能含本机绝对路径，不适合提交：
#     .config/projects.json  实例注册表（记录 D:\code\... 这类路径）
#     .config/app.lock       单实例文件锁
#     logs/                  运行日志
#     ymls/                  默认的 yml 保存目录（用户的同步项目）
# ============================================================
.config/
logs/
ymls/

# ============================================================
#  Mutagen 的残留物
#
#  <yml>.lock    Mutagen 的项目锁文件（见 README 的「残留锁文件」一节）
#  <yml>.bak     GUI 覆盖保存时的自动备份
# ============================================================
*.yml.lock
*.yml.bak

# ============================================================
#  设计文档：暂不公开
#
#  requirements.md 里含真实服务器主机 / 端口 / 密钥文件名，
#  确认脱敏后再单独提交。
# ============================================================
requirements.md

